# Life Science Pharmaceutical – Apache / LiteSpeed config (Hostinger / cPanel hosting).
# Copied into dist/ by Vite. Firebase Hosting ignores this file (it uses firebase.json instead).

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Always use https://lifesciencepharmaceutical.in (no www) – one address for Google (SEO).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Single-page app: any URL that is not a real file/folder shows index.html
  #    (so /products, /product/xyz, /contact etc. work on refresh and direct links).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Speed: gzip text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Speed: cache rules (same as firebase.json)
<IfModule mod_headers.c>
  # Pages and the service worker must always be fresh, so new deploys show immediately.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <Files "firebase-messaging-sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  # Built JS/CSS (file names contain a hash) and images can be cached for a year.
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "firebase-messaging-sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
